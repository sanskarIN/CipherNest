<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CipherNest.App.Views.ItemEditorPage">
  <ScrollView><VerticalStackLayout Padding="22" Spacing="12" MaximumWidthRequest="760" HorizontalOptions="Center">
    <Grid ColumnDefinitions="*,Auto"><Label Text="Vault item" Style="{StaticResource TitleLabel}"/><Button Grid.Column="1" Text="Back" Clicked="OnBackClicked" Style="{StaticResource SecondaryButton}"/></Grid>
    <Frame IsVisible="{Binding IsReauthenticationRequired}"><VerticalStackLayout Spacing="10"><Label Text="This item requires re-authentication" FontAttributes="Bold" FontSize="20"/><Label Text="Confirm the current master passphrase before CipherNest displays or modifies this item's decrypted fields. Recovery keys are not accepted for this check."/><Entry Text="{Binding ReauthenticationPassphrase}" IsPassword="True" Placeholder="Current master passphrase"/><Button Text="Unlock this item" Command="{Binding ReauthenticateCommand}"/></VerticalStackLayout></Frame>
    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsReauthenticationRequired, Converter={StaticResource InverseBoolConverter}}">
      <Label Text="Type" FontAttributes="Bold"/><Picker ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"/>
      <Label Text="Title" FontAttributes="Bold"/><Entry Text="{Binding Title}" Placeholder="Required"/>
      <Label Text="Collection / folder" FontAttributes="Bold"/><Entry Text="{Binding Collection}" Placeholder="Optional collection"/>
      <Label Text="Username / identifier" FontAttributes="Bold"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Entry Text="{Binding Username}"/><Button Grid.Column="1" Text="Copy" Command="{Binding CopyUsernameCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
      <Label Text="Secret" FontAttributes="Bold"/><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><Entry Text="{Binding Secret}" IsPassword="{Binding IsSecretVisible, Converter={StaticResource InverseBoolConverter}}"/><Button Grid.Column="1" Text="Reveal" Command="{Binding ToggleSecretCommand}" Style="{StaticResource SecondaryButton}"/><Button Grid.Column="2" Text="Copy" Command="{Binding CopySecretCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
      <Frame IsVisible="{Binding IsTotpItem}"><VerticalStackLayout Spacing="10">
        <Label Text="Time-based one-time password (TOTP)" FontAttributes="Bold" FontSize="18"/>
        <Label Text="For this item type, Secret is the Base32 TOTP seed. The seed is stored only inside the encrypted vault record. Generated codes are computed locally while unlocked and are not persisted." Style="{StaticResource SubtitleLabel}"/>
        <Label Text="Import a TOTP setup URI" FontAttributes="Bold"/>
        <Label Text="Paste a bounded otpauth://totp/... URI. The URI contains the seed, is processed locally, is cleared from this editor after import, and must be protected like the seed itself. HOTP is intentionally rejected." Style="{StaticResource SubtitleLabel}"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <Entry Text="{Binding TotpUriImportText}" IsPassword="True" Placeholder="otpauth://totp/..." SemanticProperties.Description="Sensitive TOTP setup URI to import locally"/>
          <Button Grid.Column="1" Text="Import URI" Command="{Binding ImportTotpUriCommand}" Style="{StaticResource SecondaryButton}"/>
        </Grid>
        <Button Text="Copy setup URI" Command="{Binding CopyTotpUriCommand}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" SemanticProperties.Description="Copy a TOTP setup URI containing this encrypted seed using timed clipboard cleanup"/>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
          <VerticalStackLayout><Label Text="Algorithm" FontAttributes="Bold"/><Picker ItemsSource="{Binding TotpAlgorithms}" SelectedItem="{Binding SelectedTotpAlgorithm}"/></VerticalStackLayout>
          <VerticalStackLayout Grid.Column="1"><Label Text="Digits" FontAttributes="Bold"/><Picker ItemsSource="{Binding TotpDigitOptions}" SelectedItem="{Binding TotpDigits}"/></VerticalStackLayout>
        </Grid>
        <Label Text="{Binding TotpPeriodSeconds, StringFormat='Period: {0} seconds'}" FontAttributes="Bold"/>
        <Stepper Minimum="15" Maximum="120" Increment="15" Value="{Binding TotpPeriodSeconds}"/>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <Label Text="{Binding CurrentTotpCode}" FontSize="28" FontAttributes="Bold" VerticalTextAlignment="Center" SemanticProperties.Description="Current locally generated one-time password"/>
          <Button Grid.Column="1" Text="Refresh code" Command="{Binding RefreshTotpCommand}" Style="{StaticResource SecondaryButton}"/>
          <Button Grid.Column="2" Text="Copy code" Command="{Binding CopyTotpCodeCommand}" Style="{StaticResource SecondaryButton}" SemanticProperties.Description="Copy the current one-time password temporarily"/>
        </Grid>
        <Label Text="{Binding TotpSecondsRemaining, StringFormat='Valid for about {0} more seconds after refresh.'}" Style="{StaticResource SubtitleLabel}"/>
        <Label Text="Only import TOTP seeds you are authorized to use. Copying a seed, setup URI, or generated code can expose it through operating-system clipboard history or synchronization; CipherNest applies the same best-effort timed clipboard cleanup policy used for other secrets." Style="{StaticResource SubtitleLabel}"/>
      </VerticalStackLayout></Frame>
      <Label Text="URL" FontAttributes="Bold"/><Entry Text="{Binding Url}" Keyboard="Url"/>
      <Label Text="Tags" FontAttributes="Bold"/><Entry Text="{Binding Tags}" Placeholder="comma, separated, tags"/>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><CheckBox IsChecked="{Binding IsFavorite}"/><Label Grid.Column="1" Text="Favorite" VerticalTextAlignment="Center"/></Grid>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><CheckBox IsChecked="{Binding RequiresReauthentication}"/><Label Grid.Column="1" Text="Require master-passphrase re-authentication whenever this item is opened" VerticalTextAlignment="Center"/></Grid>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><CheckBox IsChecked="{Binding HasReviewDate}"/><Label Grid.Column="1" Text="Set review / expiration reminder date" VerticalTextAlignment="Center"/></Grid>
      <DatePicker Date="{Binding ReviewDate}" IsEnabled="{Binding HasReviewDate}"/>
      <Label Text="Custom fields" FontAttributes="Bold"/><Label Text="One name=value per line. Prefix secrets with [secret], for example [secret]PIN=1234. Custom fields are encrypted with the item. Secret values are never displayed in the copy list below." Style="{StaticResource SubtitleLabel}"/><Editor Text="{Binding CustomFieldsText}" AutoSize="TextChanges" MinimumHeightRequest="100"/>
      <CollectionView ItemsSource="{Binding SecretCustomFields}" EmptyView="No secret custom fields available for quick copy."><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Padding="0,3" ColumnSpacing="8"><Label Text="{Binding Name}" VerticalTextAlignment="Center"/><Button Grid.Column="1" Text="Copy secret" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CopyCustomSecretCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" SemanticProperties.Description="Copy this encrypted custom secret to the clipboard temporarily"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
      <Frame><VerticalStackLayout Spacing="10"><Grid ColumnDefinitions="*,Auto"><Label Text="Secure note" FontAttributes="Bold"/><Button Grid.Column="1" Text="Preview" Command="{Binding ToggleNotePreviewCommand}" Style="{StaticResource SecondaryButton}"/></Grid><Label Text="Safe local Markdown subset: headings (#), bullets (-), checklists (- [ ] / - [x]), and fenced code. HTML is never rendered." Style="{StaticResource SubtitleLabel}"/><Editor Text="{Binding Notes}" AutoSize="TextChanges" MinimumHeightRequest="150" SemanticProperties.Description="Encrypted secure note Markdown editor"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Entry Text="{Binding ChecklistDraft}" Placeholder="Add secure checklist item" ReturnType="Done"/><Button Grid.Column="1" Text="Add checklist" Command="{Binding AddChecklistItemCommand}" Style="{StaticResource SecondaryButton}"/></Grid><Frame IsVisible="{Binding ShowNotePreview}" BackgroundColor="{AppThemeBinding Light=#F4F7FA, Dark=#18232E}"><VerticalStackLayout Spacing="6"><Label Text="Safe preview" FontAttributes="Bold"/><Label Text="{Binding NotePreview}" LineBreakMode="WordWrap" SemanticProperties.Description="Safe plaintext preview of the secure note"/></VerticalStackLayout></Frame></VerticalStackLayout></Frame>
      <Frame><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="*,Auto"><Label Text="Encrypted attachments" FontAttributes="Bold"/><Button Grid.Column="1" Text="Add file" Command="{Binding AddAttachmentCommand}" Style="{StaticResource SecondaryButton}"/></Grid><Label Text="Files are encrypted in streaming chunks and capped at 100 MB each. Small UTF-8 TXT, Markdown, CSV, JSON, and LOG files can be previewed in memory. Export creates a temporary plaintext copy and requires explicit confirmation." Style="{StaticResource SubtitleLabel}"/><CollectionView ItemsSource="{Binding Attachments}" EmptyView="No attachments"><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="0,4" ColumnSpacing="8"><VerticalStackLayout><Label Text="{Binding DisplayName}"/><Label Text="{Binding PlaintextLength, StringFormat='{0} bytes'}" Style="{StaticResource SubtitleLabel}"/></VerticalStackLayout><Button Grid.Column="1" Text="Preview" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PreviewAttachmentCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}"/><Button Grid.Column="2" Text="Export" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ExportAttachmentCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}"/><Button Grid.Column="3" Text="Remove" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveAttachmentCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></Frame>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="Save" Command="{Binding SaveCommand}"/><Button Grid.Column="1" Text="Move to trash" Command="{Binding MoveToTrashCommand}" IsVisible="{Binding IsExisting}" BackgroundColor="{StaticResource Danger}"/></Grid>
    </VerticalStackLayout>
    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" SemanticProperties.Description="Vault item error status"/><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
  </VerticalStackLayout></ScrollView>
</ContentPage>
