<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:shared="clr-namespace:CipherNest.Shared;assembly=CipherNest.Shared" x:Class="CipherNest.App.Views.AboutPage">
  <ScrollView><VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="720" HorizontalOptions="Center">
    <Image Source="ciphernest_logo.svg" HeightRequest="96" SemanticProperties.Description="CipherNest logo"/>
    <Label Text="{x:Static shared:AppConstants.ProductName}" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center"/>
    <Button x:Name="VersionButton" Text="Version and build" Clicked="OnVersionClicked" Style="{StaticResource SecondaryButton}" SemanticProperties.Description="Version and build information. Repeated activation opens developer options."/>
    <Label Text="{x:Static shared:AppConstants.Watermark}" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
    <Frame><VerticalStackLayout Spacing="8"><Label Text="Security status" FontAttributes="Bold"/><Label Text="CipherNest uses established cryptographic primitives and local-only storage, but this release has not completed an independent professional security audit. Open source does not itself guarantee security."/><Button Text="Read security &amp; privacy information" Clicked="OnSecurityInfoClicked" Style="{StaticResource SecondaryButton}"/></VerticalStackLayout></Frame>
    <Frame x:Name="SupportDevelopmentFrame" BorderColor="#FFDD57" BackgroundColor="{AppThemeBinding Light=#FFF8D6, Dark=#2A2210}" Padding="16">
      <VerticalStackLayout Spacing="10">
        <Label Text="☕ Support CipherNest development" FontAttributes="Bold" FontSize="20" TextColor="{AppThemeBinding Light=#3A2C00, Dark=#FFDD57}" SemanticProperties.HeadingLevel="Level2"/>
        <Image Source="bmc_support.svg" HeightRequest="150" Aspect="AspectFit" SemanticProperties.Description="BMC Support CipherNest badge. Activate to open the Buy Me a Coffee support page.">
          <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnBuyMeACoffeeClicked"/></Image.GestureRecognizers>
        </Image>
        <Label Text="If CipherNest is useful to you, you can optionally support continued open-source development through Buy Me a Coffee. Support is voluntary and does not change security, privacy, licensing, support priority, recovery, or feature access."/>
        <Label Text="{x:Static shared:AppConstants.BuyMeACoffeeUrl}" LineBreakMode="CharacterWrap" FontAttributes="Bold"/>
        <Button Text="☕ Open Buy Me a Coffee" Clicked="OnBuyMeACoffeeClicked" BackgroundColor="#FFDD57" TextColor="#171717" FontAttributes="Bold" SemanticProperties.Description="Open the CipherNest Buy Me a Coffee support page in the system browser"/>
      </VerticalStackLayout>
    </Frame>
    <Frame><VerticalStackLayout Spacing="8"><Label Text="Open source &amp; license" FontAttributes="Bold"/><Label Text="CipherNest client source is available under GPL-3.0-or-later. Contributions remain subject to the repository contribution, conduct, security, and license terms."/><Button Text="Open CipherNest repository" Clicked="OnRepositoryClicked" Style="{StaticResource SecondaryButton}" SemanticProperties.Description="Open the CipherNest GitHub repository in the system browser"/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="8"><Label Text="Third-party notices" FontAttributes="Bold"/><Label Text="Runtime dependencies include CommunityToolkit.Mvvm, Konscious.Security.Cryptography.Argon2, Microsoft.Data.Sqlite, Microsoft.Extensions.Logging.Debug, and Microsoft.Maui.Controls. Their licenses remain their own. THIRD_PARTY_NOTICES.md records the dependency/license families and release-review requirement."/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="8"><Label Text="Privacy &amp; terms" FontAttributes="Bold"/><Label Text="The current release is local-only and does not intentionally send vault contents, analytics, or telemetry to a CipherNest service. User-initiated plaintext export leaves the protected vault boundary. Full repository notices are in PRIVACY.md and TERMS.md."/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="8"><Label Text="Acknowledgements" FontAttributes="Bold"/><Label Text="CipherNest is built with .NET MAUI, C#, SQLite, maintained .NET cryptography, Argon2id support from a third-party library, CommunityToolkit.Mvvm, and the open-source ecosystem documented in THIRD_PARTY_NOTICES.md."/></VerticalStackLayout></Frame>
    <Label><Label.FormattedText><FormattedString><Span Text="Business: "/><Span Text="{x:Static shared:AppConstants.BusinessEmail}"/></FormattedString></Label.FormattedText></Label>
    <Label><Label.FormattedText><FormattedString><Span Text="Support: "/><Span Text="{x:Static shared:AppConstants.SupportEmail}"/></FormattedString></Label.FormattedText></Label>
    <Label><Label.FormattedText><FormattedString><Span Text="Repository: "/><Span Text="{x:Static shared:AppConstants.RepositoryUrl}"/></FormattedString></Label.FormattedText></Label>
    <Label><Label.FormattedText><FormattedString><Span Text="Creator: "/><Span Text="{x:Static shared:AppConstants.CreatorUrl}"/></FormattedString></Label.FormattedText></Label>
    <Label x:Name="SupportDevelopmentMetadataLabel"><Label.FormattedText><FormattedString><Span Text="Support development: "/><Span Text="{x:Static shared:AppConstants.BuyMeACoffeeUrl}"/></FormattedString></Label.FormattedText></Label>
    <Label Text="License: GPL-3.0-or-later"/>
    <Button Text="Open creator profile" Clicked="OnCreatorClicked" Style="{StaticResource SecondaryButton}" SemanticProperties.Description="Open the creator GitHub profile in the system browser"/>
    <Button Text="Back to vault" Clicked="OnBackClicked"/>
  </VerticalStackLayout></ScrollView>
</ContentPage>
