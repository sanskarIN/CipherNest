<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CipherNest.App.Views.GeneratorDefaultsPage">
  <ScrollView><VerticalStackLayout Padding="22" Spacing="14" MaximumWidthRequest="720" HorizontalOptions="Center">
    <Grid ColumnDefinitions="*,Auto"><Label Text="Generator defaults" Style="{StaticResource TitleLabel}"/><Button Grid.Column="1" Text="Back" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
    <Label Text="These defaults are stored locally and applied when the password generator opens." Style="{StaticResource SubtitleLabel}"/>
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Switch IsToggled="{Binding PassphraseMode}"/><Label Grid.Column="1" Text="Default to memorable passphrase mode" VerticalTextAlignment="Center"/></Grid>
    <Label Text="Default password length (8–256)"/><Entry Text="{Binding PasswordLength}" Keyboard="Numeric"/>
    <Label Text="Default passphrase words (6–16)"/><Entry Text="{Binding PassphraseWordCount}" Keyboard="Numeric"/>
    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
      <CheckBox IsChecked="{Binding Uppercase}"/><Label Grid.Column="1" Text="Uppercase" VerticalTextAlignment="Center"/>
      <CheckBox Grid.Column="2" IsChecked="{Binding Lowercase}"/><Label Grid.Column="3" Text="Lowercase" VerticalTextAlignment="Center"/>
      <CheckBox Grid.Row="1" IsChecked="{Binding Digits}"/><Label Grid.Row="1" Grid.Column="1" Text="Digits" VerticalTextAlignment="Center"/>
      <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding Symbols}"/><Label Grid.Row="1" Grid.Column="3" Text="Symbols" VerticalTextAlignment="Center"/>
    </Grid>
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><CheckBox IsChecked="{Binding ExcludeAmbiguous}"/><Label Grid.Column="1" Text="Exclude ambiguous characters" VerticalTextAlignment="Center"/></Grid>
    <Button Text="Save generator defaults" Command="{Binding SaveCommand}"/>
    <Label Text="{Binding StatusMessage}" SemanticProperties.Description="Generator settings status"/>
  </VerticalStackLayout></ScrollView>
</ContentPage>
