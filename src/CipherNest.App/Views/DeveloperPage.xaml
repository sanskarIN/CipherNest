<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CipherNest.App.Views.DeveloperPage">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="760" HorizontalOptions="Center">
      <Grid ColumnDefinitions="*,Auto"><Label Text="Developer options" Style="{StaticResource TitleLabel}"/><Button Grid.Column="1" Text="Back" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
      <Label Text="These options intentionally expose no decrypted records or cryptographic keys." Style="{StaticResource SubtitleLabel}"/>
      <Frame><VerticalStackLayout Spacing="8"><Label Text="Format information" FontAttributes="Bold"/><Label Text="{Binding CryptoInfo}"/><Label Text="{Binding SchemaInfo}"/><Label Text="{Binding DatabaseInfo}"/><Label Text="{Binding StorageInfo}"/></VerticalStackLayout></Frame>
      <Frame><VerticalStackLayout Spacing="8"><Label Text="Sanitized dependency list" FontAttributes="Bold"/><Label Text="{Binding Dependencies}"/></VerticalStackLayout></Frame>
      <Button Text="Export redacted diagnostics" Command="{Binding ExportDiagnosticsCommand}"/>
      <Button Text="Simulate lock lifecycle" Command="{Binding SimulateLockCommand}" Style="{StaticResource SecondaryButton}"/>
      <Label Text="{Binding StatusMessage}"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
