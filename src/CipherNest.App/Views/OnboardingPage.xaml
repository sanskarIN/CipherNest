<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CipherNest.App.Views.OnboardingPage">
  <ScrollView><VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="640" HorizontalOptions="Center"><Image Source="ciphernest_logo.svg" HeightRequest="88"/><Label Text="Create your local vault" Style="{StaticResource TitleLabel}"/><Label Text="CipherNest stores the current release entirely on this device. No account or cloud service is required." Style="{StaticResource SubtitleLabel}"/><Frame IsVisible="{Binding ShowRecoveryKey}"><VerticalStackLayout Spacing="12"><Label Text="Save your recovery key now" FontAttributes="Bold" FontSize="20"/><Label Text="This key can unlock your vault if you forget the master passphrase. It is shown only during setup; CipherNest cannot retrieve it later. Store it separately from this device."/><Entry Text="{Binding RecoveryKey}" IsReadOnly="True" SemanticProperties.Description="Recovery key shown once"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><CheckBox IsChecked="{Binding RecoveryKeySaved}"/><Label Grid.Column="1" Text="I saved the recovery key in a separate safe place." VerticalTextAlignment="Center"/></Grid><Button Text="Continue to vault" Command="{Binding ContinueCommand}"/></VerticalStackLayout></Frame><VerticalStackLayout Spacing="14" IsVisible="{Binding ShowRecoveryKey, Converter={StaticResource InverseBoolConverter}}"><Frame><VerticalStackLayout Spacing="10"><Label Text="Recovery limitation" FontAttributes="Bold"/><Label Text="If you lose the master passphrase and any optional recovery key, CipherNest cannot recover this local-only vault."/></VerticalStackLayout></Frame><Label Text="Master passphrase" FontAttributes="Bold"/><Entry Text="{Binding MasterPassphrase}" IsPassword="True" Placeholder="Long, unique and strong" ReturnType="Next"/><Label Text="{Binding StrengthLabel}" Style="{StaticResource SubtitleLabel}"/><Label Text="Confirm master passphrase" FontAttributes="Bold"/><Entry Text="{Binding Confirmation}" IsPassword="True" Placeholder="Re-enter the passphrase" ReturnType="Done"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><CheckBox IsChecked="{Binding RecoveryKeyEnabled}"/><Label Grid.Column="1" Text="Generate an optional local recovery key and show it once" VerticalTextAlignment="Center"/></Grid><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><CheckBox IsChecked="{Binding RecoveryLimitAcknowledged}"/><Label Grid.Column="1" Text="I understand the recovery limitations." VerticalTextAlignment="Center"/></Grid><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"/><Button Text="Create vault" Command="{Binding CreateVaultCommand}"/><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/></VerticalStackLayout><Label Text="Made by the Sanskar" Style="{StaticResource SubtitleLabel}" HorizontalTextAlignment="Center" Margin="0,24,0,0"/></VerticalStackLayout></ScrollView>
</ContentPage>
