<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:CipherNest.App.Localization" x:Class="CipherNest.App.Views.OnboardingPage">
  <ScrollView><VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="640" HorizontalOptions="Center"><Image Source="ciphernest_logo.svg" HeightRequest="88" SemanticProperties.Description="{l10n:Translate CipherNestLogoSemanticDescription}"/><Label Text="{l10n:Translate OnboardingCreateVaultTitle}" Style="{StaticResource TitleLabel}"/><Label Text="{l10n:Translate OnboardingLocalSummary}" Style="{StaticResource SubtitleLabel}"/><Frame IsVisible="{Binding ShowRecoveryKey}"><VerticalStackLayout Spacing="12"><Label Text="{l10n:Translate OnboardingSaveRecoveryKeyTitle}" FontAttributes="Bold" FontSize="20"/><Label Text="{l10n:Translate OnboardingRecoveryKeyExplanation}"/><Entry Text="{Binding RecoveryKey}" IsReadOnly="True" SemanticProperties.Description="{l10n:Translate OnboardingRecoveryKeySemanticDescription}"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><CheckBox IsChecked="{Binding RecoveryKeySaved}"/><Label Grid.Column="1" Text="{l10n:Translate OnboardingRecoveryKeySavedAcknowledgement}" VerticalTextAlignment="Center"/></Grid><Button Text="{l10n:Translate OnboardingContinueButton}" Command="{Binding ContinueCommand}"/></VerticalStackLayout></Frame><VerticalStackLayout Spacing="14" IsVisible="{Binding ShowRecoveryKey, Converter={StaticResource InverseBoolConverter}}"><Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate OnboardingRecoveryLimitationTitle}" FontAttributes="Bold"/><Label Text="{l10n:Translate OnboardingRecoveryLimitationBody}"/></VerticalStackLayout></Frame><Label Text="{l10n:Translate MasterPassphraseLabel}" FontAttributes="Bold"/><Entry Text="{Binding MasterPassphrase}" IsPassword="True" Placeholder="{l10n:Translate MasterPassphrasePlaceholder}" ReturnType="Next"/><Label Text="{Binding StrengthLabel}" Style="{StaticResource SubtitleLabel}"/><Label Text="{l10n:Translate ConfirmMasterPassphraseLabel}" FontAttributes="Bold"/><Entry Text="{Binding Confirmation}" IsPassword="True" Placeholder="{l10n:Translate ConfirmMasterPassphrasePlaceholder}" ReturnType="Done"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><CheckBox IsChecked="{Binding RecoveryKeyEnabled}"/><Label Grid.Column="1" Text="{l10n:Translate OnboardingGenerateRecoveryOption}" VerticalTextAlignment="Center"/></Grid><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><CheckBox IsChecked="{Binding RecoveryLimitAcknowledged}"/><Label Grid.Column="1" Text="{l10n:Translate OnboardingRecoveryAcknowledgement}" VerticalTextAlignment="Center"/></Grid><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" SemanticProperties.Description="{l10n:Translate OnboardingErrorSemanticDescription}"/><Button Text="{l10n:Translate OnboardingCreateButton}" Command="{Binding CreateVaultCommand}"/><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/></VerticalStackLayout><Label Text="Made by the Sanskar" Style="{StaticResource SubtitleLabel}" HorizontalTextAlignment="Center" Margin="0,24,0,0"/></VerticalStackLayout></ScrollView>
</ContentPage>
