<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:CipherNest.App.Localization" x:Class="CipherNest.App.Views.TransferPage">
  <ScrollView>
    <VerticalStackLayout Padding="22" Spacing="14" MaximumWidthRequest="760" HorizontalOptions="Center">
      <Grid ColumnDefinitions="*,Auto"><Label Text="{l10n:Translate TransferTitle}" Style="{StaticResource TitleLabel}"/><Button Grid.Column="1" Text="{l10n:Translate BackButton}" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
      <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate TransferImportHeading}" FontAttributes="Bold" FontSize="20"/><Label Text="{l10n:Translate TransferImportSummary}" Style="{StaticResource SubtitleLabel}"/><Button Text="{l10n:Translate TransferSelectCsvButton}" Command="{Binding PickCsvCommand}"/><Label Text="{Binding SelectedFileName}"/><Label Text="{l10n:Translate TransferTitleColumnRequiredLabel}"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding TitleColumn}"/><Label Text="{l10n:Translate TransferUsernameColumnLabel}"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding UsernameColumn}"/><Label Text="{l10n:Translate TransferSecretColumnLabel}"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding SecretColumn}"/><Label Text="{l10n:Translate TransferUrlColumnLabel}"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding UrlColumn}"/><Label Text="{l10n:Translate TransferNotesColumnLabel}"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding NotesColumn}"/><Label Text="{l10n:Translate TransferTagsColumnLabel}"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding TagsColumn}"/><Label Text="{l10n:Translate TransferCollectionColumnLabel}"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding CollectionColumn}"/><Label Text="{l10n:Translate TransferTypeColumnLabel}"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding TypeColumn}"/><Button Text="{l10n:Translate TransferImportMappingsButton}" Command="{Binding ImportCommand}"/></VerticalStackLayout></Frame>
      <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate TransferPlaintextExportHeading}" FontAttributes="Bold" FontSize="20" TextColor="{StaticResource Danger}"/><Label Text="{l10n:Translate TransferPlaintextExportWarning}"/><Entry Text="{Binding ExportMasterPassphrase}" IsPassword="True" Placeholder="{l10n:Translate TransferMasterPlaceholder}" SemanticProperties.Description="{l10n:Translate TransferExportMasterSemanticDescription}"/><Entry Text="{Binding ExportConfirmationPhrase}" Placeholder="{l10n:Translate TransferConfirmationPlaceholder}" SemanticProperties.Description="{l10n:Translate TransferExportPhraseSemanticDescription}"/><Button Text="{l10n:Translate TransferExportButton}" Command="{Binding ExportPlaintextCommand}" BackgroundColor="{StaticResource Danger}" SemanticProperties.Description="{l10n:Translate TransferExportButtonSemanticDescription}"/><Button Text="{l10n:Translate TransferCleanCacheButton}" Command="{Binding CleanPlaintextCacheCommand}" Style="{StaticResource SecondaryButton}" SemanticProperties.Description="{l10n:Translate TransferCleanCacheSemanticDescription}"/></VerticalStackLayout></Frame>
      <Label Text="{Binding StatusMessage}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
