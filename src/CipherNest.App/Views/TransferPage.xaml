<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CipherNest.App.Views.TransferPage">
  <ScrollView>
    <VerticalStackLayout Padding="22" Spacing="14" MaximumWidthRequest="760" HorizontalOptions="Center">
      <Grid ColumnDefinitions="*,Auto"><Label Text="Import &amp; plaintext export" Style="{StaticResource TitleLabel}"/><Button Grid.Column="1" Text="Back" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
      <Frame><VerticalStackLayout Spacing="10"><Label Text="Import generic CSV" FontAttributes="Bold" FontSize="20"/><Label Text="Select a CSV, then explicitly map its columns. The source CSV remains plaintext outside CipherNest." Style="{StaticResource SubtitleLabel}"/><Button Text="Select CSV" Command="{Binding PickCsvCommand}"/><Label Text="{Binding SelectedFileName}"/><Label Text="Title column (required)"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding TitleColumn}"/><Label Text="Username column"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding UsernameColumn}"/><Label Text="Password / secret column"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding SecretColumn}"/><Label Text="URL column"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding UrlColumn}"/><Label Text="Notes column"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding NotesColumn}"/><Label Text="Tags column"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding TagsColumn}"/><Label Text="Collection / folder column"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding CollectionColumn}"/><Label Text="Item type column"/><Picker ItemsSource="{Binding Headers}" SelectedItem="{Binding TypeColumn}"/><Button Text="Import with these mappings" Command="{Binding ImportCommand}"/></VerticalStackLayout></Frame>
      <Frame><VerticalStackLayout Spacing="10"><Label Text="Plaintext CSV export" FontAttributes="Bold" FontSize="20" TextColor="{StaticResource Danger}"/><Label Text="Encrypted backup is recommended. Plaintext export exposes readable usernames, secrets, URLs, notes, tags and collections. Attachments are deliberately excluded."/><Entry Text="{Binding ExportMasterPassphrase}" IsPassword="True" Placeholder="Confirm master passphrase"/><Entry Text="{Binding ExportConfirmationPhrase}" Placeholder="Type EXPORT PLAINTEXT"/><Button Text="Export plaintext CSV" Command="{Binding ExportPlaintextCommand}" BackgroundColor="{StaticResource Danger}"/><Button Text="Clean plaintext export cache" Command="{Binding CleanPlaintextCacheCommand}" Style="{StaticResource SecondaryButton}"/></VerticalStackLayout></Frame>
      <Label Text="{Binding StatusMessage}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
