<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CipherNest.App.Views.SettingsPage">
  <ScrollView>
    <VerticalStackLayout Padding="22" Spacing="14" MaximumWidthRequest="760" HorizontalOptions="Center">
      <Grid ColumnDefinitions="*,Auto"><Label Text="Settings" Style="{StaticResource TitleLabel}"/><Button Grid.Column="1" Text="Back" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
      <Label Text="Appearance" FontAttributes="Bold"/><Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/>
      <Label Text="Lock timeout (seconds)" FontAttributes="Bold"/><Entry Text="{Binding LockTimeoutSeconds}" Keyboard="Numeric"/>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding LockOnBackground}"/><Label Grid.Column="1" Text="Lock when app moves to background" VerticalTextAlignment="Center"/></Grid>
      <Label Text="Clipboard clear interval (seconds)" FontAttributes="Bold"/><Entry Text="{Binding ClipboardClearSeconds}" Keyboard="Numeric"/>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding ScreenshotProtection}"/><Label Grid.Column="1" Text="Screenshot protection where supported" VerticalTextAlignment="Center"/></Grid>
      <Label Text="{Binding ScreenshotSupportMessage}" Style="{StaticResource SubtitleLabel}"/>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding ReducedMotion}"/><Label Grid.Column="1" Text="Reduced motion preference" VerticalTextAlignment="Center"/></Grid>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding LargerInterface}"/><Label Grid.Column="1" Text="Larger interface preference" VerticalTextAlignment="Center"/></Grid>
      <Button Text="Save settings" Command="{Binding SaveCommand}"/>
      <Frame><VerticalStackLayout Spacing="10"><Label Text="Encrypted backup" FontAttributes="Bold"/><Label Text="Use a separate strong backup passphrase. CipherNest does not store it." Style="{StaticResource SubtitleLabel}"/><Entry Text="{Binding BackupPassphrase}" IsPassword="True" Placeholder="Backup passphrase (12+ characters)"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="Create backup" Command="{Binding ExportBackupCommand}"/><Button Grid.Column="1" Text="Restore backup" Command="{Binding RestoreBackupCommand}" Style="{StaticResource SecondaryButton}"/></Grid></VerticalStackLayout></Frame>
      <Frame><VerticalStackLayout Spacing="8"><Label Text="Danger zone" FontAttributes="Bold" TextColor="{StaticResource Danger}"/><Button Text="Full vault deletion guidance" Command="{Binding DeleteVaultCommand}" BackgroundColor="{StaticResource Danger}"/></VerticalStackLayout></Frame>
      <Label Text="{Binding StatusMessage}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
