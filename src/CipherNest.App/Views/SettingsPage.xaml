<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:services="clr-namespace:CipherNest.App.Services" xmlns:l10n="clr-namespace:CipherNest.App.Localization" x:Class="CipherNest.App.Views.SettingsPage">
  <ScrollView><VerticalStackLayout Padding="22" Spacing="14" MaximumWidthRequest="760" HorizontalOptions="Center">
    <Grid ColumnDefinitions="*,Auto"><Label Text="{l10n:Translate SettingsTitle}" Style="{StaticResource TitleLabel}"/><Button Grid.Column="1" Text="{l10n:Translate BackButton}" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate SettingsAppearanceAccessibilityTitle}" FontAttributes="Bold" FontSize="20"/><Label Text="{l10n:Translate SettingsThemeLabel}"/><Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/><Label Text="{l10n:Translate SettingsLanguageLabel}"/><Picker ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"/><Label Text="{l10n:Translate SettingsLanguageSummary}" Style="{StaticResource SubtitleLabel}"/><Button Text="{l10n:Translate SettingsSaveLanguageButton}" Command="{Binding SaveLanguageCommand}" Style="{StaticResource SecondaryButton}"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding ReducedMotion}"/><Label Grid.Column="1" Text="{l10n:Translate SettingsReducedMotionLabel}" VerticalTextAlignment="Center"/></Grid><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding LargerInterface}"/><Label Grid.Column="1" Text="{l10n:Translate SettingsLargerInterfaceLabel}" VerticalTextAlignment="Center"/></Grid></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate SettingsLockPrivacyTitle}" FontAttributes="Bold" FontSize="20"/><Label Text="{l10n:Translate SettingsLockTimeoutLabel}"/><Entry Text="{Binding LockTimeoutSeconds}" Keyboard="Numeric"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding LockOnBackground}"/><Label Grid.Column="1" Text="{l10n:Translate SettingsLockOnBackgroundLabel}" VerticalTextAlignment="Center"/></Grid><Label Text="{l10n:Translate SettingsClipboardClearLabel}"/><Entry Text="{Binding ClipboardClearSeconds}" Keyboard="Numeric"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding ScreenshotProtection}"/><Label Grid.Column="1" Text="{l10n:Translate SettingsScreenshotProtectionLabel}" VerticalTextAlignment="Center"/></Grid><Label Text="{Binding ScreenshotSupportMessage}" Style="{StaticResource SubtitleLabel}"/><Label Text="{l10n:Translate SettingsTrashRetentionLabel}"/><Entry Text="{Binding TrashRetentionDays}" Keyboard="Numeric"/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate SettingsLocalRemindersTitle}" FontAttributes="Bold" FontSize="20"/><Label Text="{l10n:Translate SettingsBackupReminderLabel}"/><Entry Text="{Binding BackupReminderDays}" Keyboard="Numeric"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding ReviewRemindersEnabled}"/><Label Grid.Column="1" Text="{l10n:Translate SettingsReviewRemindersLabel}" VerticalTextAlignment="Center"/></Grid><Label Text="{l10n:Translate SettingsReviewReminderLeadLabel}"/><Entry Text="{Binding ReviewReminderLeadDays}" Keyboard="Numeric" IsEnabled="{Binding ReviewRemindersEnabled}"/><Label Text="{l10n:Translate SettingsReviewReminderSummary}" Style="{StaticResource SubtitleLabel}"/><Button Text="{l10n:Translate SettingsSaveSettingsButton}" Command="{Binding SaveCommand}"/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate SettingsGeneratorDefaultsTitle}" FontAttributes="Bold" FontSize="20"/><Label Text="{l10n:Translate SettingsGeneratorDefaultsSummary}" Style="{StaticResource SubtitleLabel}"/><Button Text="{l10n:Translate SettingsConfigureGeneratorButton}" Command="{Binding GeneratorDefaultsCommand}" Style="{StaticResource SecondaryButton}"/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate SettingsBiometricTitle}" FontAttributes="Bold" FontSize="20"/><Label Text="{Binding BiometricSupportMessage}" Style="{StaticResource SubtitleLabel}"/><Label Text="{l10n:Translate SettingsBiometricSummary}"/><Label Text="{l10n:Translate SettingsRequireMasterAfterLabel}"/><Entry Text="{Binding RequireMasterPassphraseAfterHours}" Keyboard="Numeric"/><Label Text="{l10n:Translate SettingsRequireMasterRange}" Style="{StaticResource SubtitleLabel}"/><Entry Text="{Binding CurrentMasterPassphrase}" IsPassword="True" Placeholder="{l10n:Translate SettingsCurrentMasterPlaceholder}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="{l10n:Translate SettingsEnableBiometricsButton}" Command="{Binding EnableBiometricUnlockCommand}" IsEnabled="{Binding BiometricAvailable}"/><Button Grid.Column="1" Text="{l10n:Translate SettingsDisableBiometricsButton}" Command="{Binding DisableBiometricUnlockCommand}" Style="{StaticResource SecondaryButton}"/></Grid></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate SettingsSecurityReviewTitle}" FontAttributes="Bold" FontSize="20"/><Label Text="{l10n:Translate SettingsSecurityReviewSummary}" Style="{StaticResource SubtitleLabel}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="{l10n:Translate SettingsRunSecurityAuditButton}" Command="{Binding SecurityAuditCommand}"/><Button Grid.Column="1" Text="{l10n:Translate SettingsSecurityPrivacyInfoButton}" Command="{Binding SecurityInfoCommand}" Style="{StaticResource SecondaryButton}"/></Grid></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate SettingsBackupRestoreTitle}" FontAttributes="Bold" FontSize="20"/><Label Text="{l10n:Translate SettingsBackupRestoreSummary}" Style="{StaticResource SubtitleLabel}"/><Entry Text="{Binding BackupPassphrase}" IsPassword="True" Placeholder="{l10n:Translate SettingsBackupPassphrasePlaceholder}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="{l10n:Translate SettingsCreateBackupButton}" Command="{Binding ExportBackupCommand}"/><Button Grid.Column="1" Text="{l10n:Translate SettingsRestoreBackupButton}" Command="{Binding RestoreBackupCommand}" Style="{StaticResource SecondaryButton}"/></Grid></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate SettingsStorageCacheTitle}" FontAttributes="Bold" FontSize="20"/><Label Text="{Binding StorageUsageMessage}" LineBreakMode="WordWrap"/><Label Text="{l10n:Translate SettingsStorageCacheSummary}" Style="{StaticResource SubtitleLabel}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="{l10n:Translate SettingsRefreshStorageButton}" Command="{Binding RefreshStorageCommand}" Style="{StaticResource SecondaryButton}"/><Button Grid.Column="1" Text="{l10n:Translate SettingsClearCacheButton}" Command="{Binding ClearCacheCommand}" Style="{StaticResource SecondaryButton}"/></Grid></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate SettingsImportExportTitle}" FontAttributes="Bold" FontSize="20"/><Label Text="{l10n:Translate SettingsImportExportSummary}" Style="{StaticResource SubtitleLabel}"/><Button Text="{l10n:Translate SettingsOpenImportExportButton}" Command="{Binding TransferCommand}" Style="{StaticResource SecondaryButton}"/></VerticalStackLayout></Frame>
    <Frame IsVisible="{x:Static services:BuildFeatureFlags.IsFundingLinkEnabled}" BorderColor="#FFDD57" BackgroundColor="{AppThemeBinding Light=#FFF8D6, Dark=#2A2210}" Padding="16">
      <VerticalStackLayout Spacing="10">
        <Label Text="{l10n:Translate SettingsFundingTitle}" FontAttributes="Bold" FontSize="20" TextColor="{AppThemeBinding Light=#3A2C00, Dark=#FFDD57}"/>
        <Image Source="bmc_support.svg" HeightRequest="130" Aspect="AspectFit" SemanticProperties.Description="{l10n:Translate SettingsFundingBadgeSemanticDescription}"/>
        <Label Text="{l10n:Translate SettingsFundingSummary}" Style="{StaticResource SubtitleLabel}"/>
        <Button Text="{l10n:Translate SettingsFundingButton}" Command="{Binding AboutCommand}" BackgroundColor="#FFDD57" TextColor="#171717" FontAttributes="Bold" SemanticProperties.Description="{l10n:Translate SettingsFundingButtonSemanticDescription}"/>
      </VerticalStackLayout>
    </Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate SettingsAboutLegalTitle}" FontAttributes="Bold" FontSize="20"/><Label Text="{l10n:Translate SettingsAboutLegalSummary}" Style="{StaticResource SubtitleLabel}"/><Button Text="{l10n:Translate SettingsOpenAboutLegalButton}" Command="{Binding AboutCommand}" Style="{StaticResource SecondaryButton}"/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate SettingsChangeMasterTitle}" FontAttributes="Bold" FontSize="20"/><Entry Text="{Binding CurrentMasterPassphrase}" IsPassword="True" Placeholder="{l10n:Translate SettingsCurrentMasterPlaceholder}"/><Entry Text="{Binding NewMasterPassphrase}" IsPassword="True" Placeholder="{l10n:Translate SettingsNewMasterPlaceholder}"/><Entry Text="{Binding ConfirmNewMasterPassphrase}" IsPassword="True" Placeholder="{l10n:Translate SettingsConfirmNewMasterPlaceholder}"/><Button Text="{l10n:Translate SettingsChangeMasterButton}" Command="{Binding ChangeMasterPassphraseCommand}"/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="{l10n:Translate SettingsDangerZoneTitle}" FontAttributes="Bold" FontSize="20" TextColor="{StaticResource Danger}"/><Label Text="{l10n:Translate SettingsDangerZoneBody}"/><Entry Text="{Binding DeletionMasterPassphrase}" IsPassword="True" Placeholder="{l10n:Translate SettingsCurrentMasterPlaceholder}"/><Entry Text="{Binding DeletionConfirmationPhrase}" Placeholder="{l10n:Translate SettingsDeletionPhrasePlaceholder}"/><Button Text="{l10n:Translate SettingsDeleteVaultButton}" Command="{Binding DeleteVaultCommand}" BackgroundColor="{StaticResource Danger}"/></VerticalStackLayout></Frame>
    <Label Text="{Binding StatusMessage}" SemanticProperties.Description="{l10n:Translate SettingsStatusSemanticDescription}"/><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
  </VerticalStackLayout></ScrollView>
</ContentPage>