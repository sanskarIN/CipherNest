<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:services="clr-namespace:CipherNest.App.Services" x:Class="CipherNest.App.Views.SettingsPage">
  <ScrollView><VerticalStackLayout Padding="22" Spacing="14" MaximumWidthRequest="760" HorizontalOptions="Center">
    <Grid ColumnDefinitions="*,Auto"><Label Text="Settings" Style="{StaticResource TitleLabel}"/><Button Grid.Column="1" Text="Back" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="Appearance &amp; accessibility" FontAttributes="Bold" FontSize="20"/><Label Text="Theme"/><Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/><Label Text="Language"/><Picker ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"/><Label Text="CipherNest ships English resources first. System language mode is retained so Hindi and additional resource catalogs can be added without changing the preference model." Style="{StaticResource SubtitleLabel}"/><Button Text="Save language preference" Command="{Binding SaveLanguageCommand}" Style="{StaticResource SecondaryButton}"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding ReducedMotion}"/><Label Grid.Column="1" Text="Reduced motion preference" VerticalTextAlignment="Center"/></Grid><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding LargerInterface}"/><Label Grid.Column="1" Text="Larger interface preference" VerticalTextAlignment="Center"/></Grid></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="Lock &amp; privacy" FontAttributes="Bold" FontSize="20"/><Label Text="Lock timeout (seconds)"/><Entry Text="{Binding LockTimeoutSeconds}" Keyboard="Numeric"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding LockOnBackground}"/><Label Grid.Column="1" Text="Lock when app moves to background" VerticalTextAlignment="Center"/></Grid><Label Text="Clipboard clear interval (seconds)"/><Entry Text="{Binding ClipboardClearSeconds}" Keyboard="Numeric"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding ScreenshotProtection}"/><Label Grid.Column="1" Text="Screenshot protection where supported" VerticalTextAlignment="Center"/></Grid><Label Text="{Binding ScreenshotSupportMessage}" Style="{StaticResource SubtitleLabel}"/><Label Text="Trash retention (days)"/><Entry Text="{Binding TrashRetentionDays}" Keyboard="Numeric"/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="Local reminders" FontAttributes="Bold" FontSize="20"/><Label Text="Encrypted backup reminder interval (days)"/><Entry Text="{Binding BackupReminderDays}" Keyboard="Numeric"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding ReviewRemindersEnabled}"/><Label Grid.Column="1" Text="Show local item review reminders while the vault is unlocked" VerticalTextAlignment="Center"/></Grid><Label Text="Review reminder lead time (days)"/><Entry Text="{Binding ReviewReminderLeadDays}" Keyboard="Numeric" IsEnabled="{Binding ReviewRemindersEnabled}"/><Label Text="Review reminders are calculated locally from encrypted item metadata after unlock; this release does not send vault details to an external notification service." Style="{StaticResource SubtitleLabel}"/><Button Text="Save settings" Command="{Binding SaveCommand}"/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="Generator defaults" FontAttributes="Bold" FontSize="20"/><Label Text="Choose local defaults for generated passwords and memorable passphrases." Style="{StaticResource SubtitleLabel}"/><Button Text="Configure generator defaults" Command="{Binding GeneratorDefaultsCommand}" Style="{StaticResource SecondaryButton}"/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="Biometric unlock" FontAttributes="Bold" FontSize="20"/><Label Text="{Binding BiometricSupportMessage}" Style="{StaticResource SubtitleLabel}"/><Label Text="Biometrics are optional and never replace your master passphrase or recovery key. Enabling creates a random secondary unlock secret protected by the operating system secure storage."/><Label Text="Require master passphrase again after (hours)"/><Entry Text="{Binding RequireMasterPassphraseAfterHours}" Keyboard="Numeric"/><Label Text="Range: 1–168 hours. A fresh app process always begins by requiring the master passphrase." Style="{StaticResource SubtitleLabel}"/><Entry Text="{Binding CurrentMasterPassphrase}" IsPassword="True" Placeholder="Current master passphrase"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="Enable biometrics" Command="{Binding EnableBiometricUnlockCommand}" IsEnabled="{Binding BiometricAvailable}"/><Button Grid.Column="1" Text="Disable biometrics" Command="{Binding DisableBiometricUnlockCommand}" Style="{StaticResource SecondaryButton}"/></Grid></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="Security review" FontAttributes="Bold" FontSize="20"/><Label Text="Run the local weak/reused/duplicate/overdue audit or review CipherNest's privacy, threat-model, audit-status, and open-source information." Style="{StaticResource SubtitleLabel}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="Run security audit" Command="{Binding SecurityAuditCommand}"/><Button Grid.Column="1" Text="Security &amp; privacy info" Command="{Binding SecurityInfoCommand}" Style="{StaticResource SecondaryButton}"/></Grid></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="Encrypted backup &amp; restore" FontAttributes="Bold" FontSize="20"/><Label Text="Use a separate strong backup passphrase. CipherNest locks before taking a consistent snapshot. Backups include the encrypted database and encrypted attachments." Style="{StaticResource SubtitleLabel}"/><Entry Text="{Binding BackupPassphrase}" IsPassword="True" Placeholder="Backup passphrase (12+ characters)"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="Create backup" Command="{Binding ExportBackupCommand}"/><Button Grid.Column="1" Text="Restore backup" Command="{Binding RestoreBackupCommand}" Style="{StaticResource SecondaryButton}"/></Grid></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="Storage &amp; cache" FontAttributes="Bold" FontSize="20"/><Label Text="{Binding StorageUsageMessage}" LineBreakMode="WordWrap"/><Label Text="Cache cleanup never intentionally deletes the encrypted vault database, encrypted attachment store, or backups kept under app data." Style="{StaticResource SubtitleLabel}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="Refresh storage" Command="{Binding RefreshStorageCommand}" Style="{StaticResource SecondaryButton}"/><Button Grid.Column="1" Text="Clear temporary cache" Command="{Binding ClearCacheCommand}" Style="{StaticResource SecondaryButton}"/></Grid></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="Import &amp; export" FontAttributes="Bold" FontSize="20"/><Label Text="Encrypted backup is recommended. Generic CSV import and guarded plaintext CSV export are available for interoperability." Style="{StaticResource SubtitleLabel}"/><Button Text="Open import &amp; export" Command="{Binding TransferCommand}" Style="{StaticResource SecondaryButton}"/></VerticalStackLayout></Frame>
    <Frame IsVisible="{x:Static services:BuildFeatureFlags.IsFundingLinkEnabled}" BorderColor="#FFDD57" BackgroundColor="{AppThemeBinding Light=#FFF8D6, Dark=#2A2210}" Padding="16">
      <VerticalStackLayout Spacing="10">
        <Label Text="☕ Support CipherNest development" FontAttributes="Bold" FontSize="20" TextColor="{AppThemeBinding Light=#3A2C00, Dark=#FFDD57}"/>
        <Image Source="bmc_support.svg" HeightRequest="130" Aspect="AspectFit" SemanticProperties.Description="BMC Support CipherNest badge"/>
        <Label Text="Buy Me a Coffee support is optional and never changes feature access, security, privacy, licensing, recovery, or support priority." Style="{StaticResource SubtitleLabel}"/>
        <Button Text="☕ View Buy Me a Coffee support" Command="{Binding AboutCommand}" BackgroundColor="#FFDD57" TextColor="#171717" FontAttributes="Bold" SemanticProperties.Description="Open the About page with the Buy Me a Coffee support link"/>
      </VerticalStackLayout>
    </Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="About, legal &amp; acknowledgements" FontAttributes="Bold" FontSize="20"/><Label Text="View version/build, GPL-3.0-or-later license, privacy/terms references, third-party notices, support contacts, repository information, acknowledgements, and audit status." Style="{StaticResource SubtitleLabel}"/><Button Text="Open About &amp; legal" Command="{Binding AboutCommand}" Style="{StaticResource SecondaryButton}"/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="Change master passphrase" FontAttributes="Bold" FontSize="20"/><Entry Text="{Binding CurrentMasterPassphrase}" IsPassword="True" Placeholder="Current master passphrase"/><Entry Text="{Binding NewMasterPassphrase}" IsPassword="True" Placeholder="New strong master passphrase"/><Entry Text="{Binding ConfirmNewMasterPassphrase}" IsPassword="True" Placeholder="Confirm new master passphrase"/><Button Text="Change master passphrase" Command="{Binding ChangeMasterPassphraseCommand}"/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="10"><Label Text="Danger zone" FontAttributes="Bold" FontSize="20" TextColor="{StaticResource Danger}"/><Label Text="Deleting the local vault cannot guarantee physical erasure from flash storage, filesystem snapshots, backups, or copies outside CipherNest."/><Entry Text="{Binding DeletionMasterPassphrase}" IsPassword="True" Placeholder="Current master passphrase"/><Entry Text="{Binding DeletionConfirmationPhrase}" Placeholder="Type DELETE MY VAULT"/><Button Text="Delete local vault" Command="{Binding DeleteVaultCommand}" BackgroundColor="{StaticResource Danger}"/></VerticalStackLayout></Frame>
    <Label Text="{Binding StatusMessage}" SemanticProperties.Description="Settings status"/><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
  </VerticalStackLayout></ScrollView>
</ContentPage>
