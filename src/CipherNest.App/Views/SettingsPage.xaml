<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CipherNest.App.Views.SettingsPage">
  <ScrollView>
    <VerticalStackLayout Padding="22" Spacing="14" MaximumWidthRequest="760" HorizontalOptions="Center">
      <Grid ColumnDefinitions="*,Auto"><Label Text="Settings" Style="{StaticResource TitleLabel}"/><Button Grid.Column="1" Text="Back" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
      <Frame><VerticalStackLayout Spacing="10"><Label Text="Appearance &amp; accessibility" FontAttributes="Bold" FontSize="20"/><Label Text="Theme"/><Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding ReducedMotion}"/><Label Grid.Column="1" Text="Reduced motion preference" VerticalTextAlignment="Center"/></Grid><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding LargerInterface}"/><Label Grid.Column="1" Text="Larger interface preference" VerticalTextAlignment="Center"/></Grid></VerticalStackLayout></Frame>
      <Frame><VerticalStackLayout Spacing="10"><Label Text="Lock &amp; privacy" FontAttributes="Bold" FontSize="20"/><Label Text="Lock timeout (seconds)"/><Entry Text="{Binding LockTimeoutSeconds}" Keyboard="Numeric"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding LockOnBackground}"/><Label Grid.Column="1" Text="Lock when app moves to background" VerticalTextAlignment="Center"/></Grid><Label Text="Clipboard clear interval (seconds)"/><Entry Text="{Binding ClipboardClearSeconds}" Keyboard="Numeric"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Switch IsToggled="{Binding ScreenshotProtection}"/><Label Grid.Column="1" Text="Screenshot protection where supported" VerticalTextAlignment="Center"/></Grid><Label Text="{Binding ScreenshotSupportMessage}" Style="{StaticResource SubtitleLabel}"/><Label Text="Trash retention (days)"/><Entry Text="{Binding TrashRetentionDays}" Keyboard="Numeric"/><Button Text="Save settings" Command="{Binding SaveCommand}"/></VerticalStackLayout></Frame>
      <Frame><VerticalStackLayout Spacing="10"><Label Text="Encrypted backup &amp; restore" FontAttributes="Bold" FontSize="20"/><Label Text="Use a separate strong backup passphrase. CipherNest does not store it. Backups include the encrypted database and encrypted attachments." Style="{StaticResource SubtitleLabel}"/><Entry Text="{Binding BackupPassphrase}" IsPassword="True" Placeholder="Backup passphrase (12+ characters)"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="Create backup" Command="{Binding ExportBackupCommand}"/><Button Grid.Column="1" Text="Restore backup" Command="{Binding RestoreBackupCommand}" Style="{StaticResource SecondaryButton}"/></Grid></VerticalStackLayout></Frame>
      <Frame><VerticalStackLayout Spacing="10"><Label Text="Import &amp; export" FontAttributes="Bold" FontSize="20"/><Label Text="Encrypted backup is recommended. Generic CSV import and guarded plaintext CSV export are available for interoperability." Style="{StaticResource SubtitleLabel}"/><Button Text="Open import &amp; export" Command="{Binding TransferCommand}" Style="{StaticResource SecondaryButton}"/></VerticalStackLayout></Frame>
      <Frame><VerticalStackLayout Spacing="10"><Label Text="Change master passphrase" FontAttributes="Bold" FontSize="20"/><Entry Text="{Binding CurrentMasterPassphrase}" IsPassword="True" Placeholder="Current master passphrase"/><Entry Text="{Binding NewMasterPassphrase}" IsPassword="True" Placeholder="New strong master passphrase"/><Entry Text="{Binding ConfirmNewMasterPassphrase}" IsPassword="True" Placeholder="Confirm new master passphrase"/><Button Text="Change master passphrase" Command="{Binding ChangeMasterPassphraseCommand}"/></VerticalStackLayout></Frame>
      <Frame><VerticalStackLayout Spacing="10"><Label Text="Danger zone" FontAttributes="Bold" FontSize="20" TextColor="{StaticResource Danger}"/><Label Text="Deleting the local vault cannot guarantee physical erasure from flash storage, filesystem snapshots, backups, or copies outside CipherNest."/><Entry Text="{Binding DeletionMasterPassphrase}" IsPassword="True" Placeholder="Current master passphrase"/><Entry Text="{Binding DeletionConfirmationPhrase}" Placeholder="Type DELETE MY VAULT"/><Button Text="Delete local vault" Command="{Binding DeleteVaultCommand}" BackgroundColor="{StaticResource Danger}"/></VerticalStackLayout></Frame>
      <Label Text="{Binding StatusMessage}"/>
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
