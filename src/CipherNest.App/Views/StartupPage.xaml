<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CipherNest.App.Views.StartupPage">
  <Grid Padding="28">
    <VerticalStackLayout Spacing="16" VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="520">
      <Image Source="appicon.svg" HeightRequest="112" WidthRequest="112" SemanticProperties.Description="CipherNest shield and nest logo" />
      <Label Text="CipherNest" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center" />
      <Label Text="Opening your local vault…" Style="{StaticResource SubtitleLabel}" HorizontalTextAlignment="Center" />
      <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" />
    </VerticalStackLayout>
  </Grid>
</ContentPage>
