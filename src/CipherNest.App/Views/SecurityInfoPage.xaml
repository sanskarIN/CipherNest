<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CipherNest.App.Views.SecurityInfoPage">
  <ScrollView><VerticalStackLayout Padding="22" Spacing="14" MaximumWidthRequest="760" HorizontalOptions="Center">
    <Grid ColumnDefinitions="*,Auto"><Label Text="Security &amp; privacy" Style="{StaticResource TitleLabel}"/><Button Grid.Column="1" Text="Back" Clicked="OnBackClicked" Style="{StaticResource SecondaryButton}"/></Grid>
    <Frame><VerticalStackLayout Spacing="8"><Label Text="Privacy model" FontAttributes="Bold" FontSize="20"/><Label Text="The current CipherNest release is local-only. It requires no account, email, phone number, server, or cloud synchronization. Vault records, encrypted attachments, settings, and encrypted backups are handled on the device unless you explicitly export or share a file."/><Label Text="No analytics or advertising identifiers are intentionally collected by CipherNest. Plaintext secrets are not included in diagnostic exports." Style="{StaticResource SubtitleLabel}"/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="8"><Label Text="What CipherNest is designed to protect against" FontAttributes="Bold" FontSize="20"/><Label Text="A copied locked vault database, many lost-device scenarios after the app is locked, accidental always-visible secrets, and unauthenticated tampering with encrypted records or backups. Offline guessing remains limited by the strength of the master passphrase and the configured Argon2id cost."/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="8"><Label Text="Partial mitigations" FontAttributes="Bold" FontSize="20"/><Label Text="Auto-lock, explicit secret reveal, clipboard clearing, screenshot blocking where supported, bounded import parsing, authenticated backups, per-item re-authentication, and optional biometrics reduce exposure but cannot eliminate risks from clipboard history, cameras, malicious accessibility services, compromised user sessions, operating-system caches, or exported plaintext."/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="8"><Label Text="Out of scope / cannot guarantee" FontAttributes="Bold" FontSize="20"/><Label Text="CipherNest cannot reliably protect secrets on a rooted, jailbroken, or otherwise privileged-compromised device; against kernel, firmware, hardware-keylogger, or hypervisor compromise; after a user intentionally exports or shares plaintext; or guarantee erasure of managed-runtime copies, flash remnants, filesystem snapshots, cloud backups, or receiving-app copies."/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="8"><Label Text="Recovery limitation" FontAttributes="Bold" FontSize="20"/><Label Text="If the master passphrase and all configured recovery material are lost, the local-only release cannot recover the vault. CipherNest does not keep a server-side recovery copy."/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="8"><Label Text="Audit status" FontAttributes="Bold" FontSize="20"/><Label Text="This release has not completed an independent professional security audit. It must not be described as unhackable, military-grade, 100% secure, or appropriate for high-risk use solely because the source is open."/><Label Text="Repository documents: docs/security/THREAT_MODEL.md, docs/security/CRYPTOGRAPHIC_DESIGN.md, SECURITY.md, PRIVACY.md, and docs/security/BIOMETRIC_UNLOCK.md." Style="{StaticResource SubtitleLabel}"/></VerticalStackLayout></Frame>
    <Frame><VerticalStackLayout Spacing="8"><Label Text="Responsible disclosure" FontAttributes="Bold" FontSize="20"/><Label Text="Report suspected security vulnerabilities privately using the instructions in SECURITY.md. Do not include real vault secrets, master passphrases, recovery keys, or decrypted records in reports."/><Label Text="Business: sanskarin@outlook.in"/><Label Text="Support: supportramsandesh@gmail.com"/></VerticalStackLayout></Frame>
  </VerticalStackLayout></ScrollView>
</ContentPage>
