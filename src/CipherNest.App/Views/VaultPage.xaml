<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:services="clr-namespace:CipherNest.App.Services" x:Class="CipherNest.App.Views.VaultPage">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" Padding="18" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout><Label Text="Your vault" Style="{StaticResource TitleLabel}"/><Label Text="Secrets stay hidden until you explicitly open or copy them." Style="{StaticResource SubtitleLabel}"/></VerticalStackLayout><Button Grid.Column="1" Text="Lock" Command="{Binding LockCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
    <Label Grid.Row="1" Text="{Binding BackupReminderMessage}" TextColor="{StaticResource Primary}" FontAttributes="Bold" SemanticProperties.Description="Backup reminder status"/>
    <Label Grid.Row="2" Text="{Binding ReviewReminderMessage}" TextColor="{StaticResource Primary}" FontAttributes="Bold" SemanticProperties.Description="Review reminder status"/>
    <SearchBar Grid.Row="3" Text="{Binding SearchText}" Placeholder="Search title, collection, tags, username, URL, notes, and custom fields" SemanticProperties.Description="Search decrypted vault content while the vault is unlocked"/>
    <Grid Grid.Row="4" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="8" ColumnSpacing="10">
      <Label Text="Sort" VerticalTextAlignment="Center" FontAttributes="Bold"/>
      <Picker Grid.Column="1" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SelectedSortMode}" Title="Sort vault items"/>
      <Label Grid.Row="1" Text="Filter" VerticalTextAlignment="Center" FontAttributes="Bold"/>
      <Picker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FilterModes}" SelectedItem="{Binding SelectedFilterMode}" Title="Filter vault items"/>
    </Grid>
    <Grid Grid.Row="5" ColumnDefinitions="Auto,*" ColumnSpacing="10"><Label Text="Collection" VerticalTextAlignment="Center" FontAttributes="Bold"/><Entry Grid.Column="1" Text="{Binding CollectionFilter}" Placeholder="Optional collection / folder filter" SemanticProperties.Description="Filter by collection name"/></Grid>
    <Grid Grid.Row="6"><CollectionView ItemsSource="{Binding Items}" SelectionMode="None" EmptyView="No matching items. Change search or filters, or add a new item."><CollectionView.ItemTemplate><DataTemplate><Frame Margin="0,5"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10"><Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" LineBreakMode="TailTruncation"/><Label Grid.Row="1" Text="{Binding Type}" Style="{StaticResource SubtitleLabel}"/><Label Grid.Row="2" Text="{Binding Collection}" Style="{StaticResource SubtitleLabel}"/><Button Grid.Column="1" Grid.RowSpan="3" Text="Open" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}"/></Grid></Frame></DataTemplate></CollectionView.ItemTemplate></CollectionView><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center"/></Grid>
    <Grid Grid.Row="7" ColumnDefinitions="*,Auto" ColumnSpacing="10"><Label Text="{Binding ResultCountMessage}" Style="{StaticResource SubtitleLabel}" VerticalTextAlignment="Center" SemanticProperties.Description="Vault result count"/><Button Grid.Column="1" Text="Load more" Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" Style="{StaticResource SecondaryButton}"/></Grid>
    <FlexLayout Grid.Row="8" Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
      <Button Text="Add" Command="{Binding AddCommand}" Margin="0,0,8,8"/>
      <Button Text="Generate" Command="{Binding GeneratorCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
      <Button Text="Audit" Command="{Binding AuditCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
      <Button Text="Trash" Command="{Binding TrashCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
      <Button Text="Settings" Command="{Binding SettingsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
      <Button Text="About" Command="{Binding AboutCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
      <Button Text="☕ Support" Command="{Binding AboutCommand}" IsVisible="{x:Static services:BuildFeatureFlags.IsFundingLinkEnabled}" BackgroundColor="#FFDD57" TextColor="#171717" FontAttributes="Bold" Margin="0,0,8,8" SemanticProperties.Description="Open the About page with Buy Me a Coffee support"/>
      <Button Text="Refresh" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
    </FlexLayout>
  </Grid>
</ContentPage>
