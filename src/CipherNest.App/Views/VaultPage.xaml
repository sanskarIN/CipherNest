<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CipherNest.App.Views.VaultPage">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="18" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout><Label Text="Your vault" Style="{StaticResource TitleLabel}"/><Label Text="Secrets stay hidden until you explicitly open or copy them." Style="{StaticResource SubtitleLabel}"/></VerticalStackLayout><Button Grid.Column="1" Text="Lock" Command="{Binding LockCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
    <SearchBar Grid.Row="1" Text="{Binding SearchText}" Placeholder="Search title, collection, tags, username, URL, notes, and custom fields"/>
    <Grid Grid.Row="2"><CollectionView ItemsSource="{Binding Items}" SelectionMode="None" EmptyView="No matching items. Add your first item with the Add button."><CollectionView.ItemTemplate><DataTemplate><Frame Margin="0,5"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10"><Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" LineBreakMode="TailTruncation"/><Label Grid.Row="1" Text="{Binding Type}" Style="{StaticResource SubtitleLabel}"/><Label Grid.Row="2" Text="{Binding Collection}" Style="{StaticResource SubtitleLabel}"/><Button Grid.Column="1" Grid.RowSpan="3" Text="Open" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}"/></Grid></Frame></DataTemplate></CollectionView.ItemTemplate></CollectionView><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center"/></Grid>
    <ScrollView Grid.Row="3" Orientation="Horizontal"><HorizontalStackLayout Spacing="8"><Button Text="Add" Command="{Binding AddCommand}"/><Button Text="Generate" Command="{Binding GeneratorCommand}" Style="{StaticResource SecondaryButton}"/><Button Text="Audit" Command="{Binding AuditCommand}" Style="{StaticResource SecondaryButton}"/><Button Text="Trash" Command="{Binding TrashCommand}" Style="{StaticResource SecondaryButton}"/><Button Text="Settings" Command="{Binding SettingsCommand}" Style="{StaticResource SecondaryButton}"/><Button Text="About" Command="{Binding AboutCommand}" Style="{StaticResource SecondaryButton}"/><Button Text="Refresh" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}"/></HorizontalStackLayout></ScrollView>
  </Grid>
</ContentPage>
