<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:CipherNest.App.Localization" x:Class="CipherNest.App.Views.TrashPage">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="22" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto"><Label Text="{l10n:Translate TrashTitle}" Style="{StaticResource TitleLabel}"/><Button Grid.Column="1" Text="{l10n:Translate BackButton}" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
    <Label Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource SubtitleLabel}" SemanticProperties.Description="{l10n:Translate TrashStatusSemanticDescription}"/>
    <Frame Grid.Row="2"><VerticalStackLayout Spacing="8"><Label Text="{l10n:Translate TrashPermanentDeletionTitle}" FontAttributes="Bold"/><Label Text="{l10n:Translate TrashPermanentDeletionSummary}" Style="{StaticResource SubtitleLabel}"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Entry Text="{Binding DeletionPassphrase}" IsPassword="True" Placeholder="{l10n:Translate TrashCurrentMasterPlaceholder}"/><Button Grid.Column="1" Text="{l10n:Translate TrashEmptyButton}" Command="{Binding EmptyTrashCommand}" BackgroundColor="{StaticResource Danger}"/></Grid></VerticalStackLayout></Frame>
    <CollectionView Grid.Row="3" ItemsSource="{Binding Items}" EmptyView="{l10n:Translate TrashEmptyView}"><CollectionView.ItemTemplate><DataTemplate><Frame Margin="0,5"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><VerticalStackLayout><Label Text="{Binding Title}" FontAttributes="Bold"/><HorizontalStackLayout Spacing="4"><Label Text="{l10n:Translate TrashDeletedLabel}" Style="{StaticResource SubtitleLabel}"/><Label Text="{Binding DeletedUtc, StringFormat='{0:g}'}" Style="{StaticResource SubtitleLabel}"/></HorizontalStackLayout></VerticalStackLayout><Button Grid.Column="1" Text="{l10n:Translate TrashRestoreButton}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RestoreCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}"/><Button Grid.Column="2" Text="{l10n:Translate TrashDeleteButton}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" BackgroundColor="{StaticResource Danger}"/></Grid></Frame></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <ActivityIndicator Grid.Row="4" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
  </Grid>
</ContentPage>
