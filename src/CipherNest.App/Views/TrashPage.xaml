<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CipherNest.App.Views.TrashPage">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="22" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto"><Label Text="Trash" Style="{StaticResource TitleLabel}"/><Button Grid.Column="1" Text="Back" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
    <Label Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource SubtitleLabel}"/>
    <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" EmptyView="Trash is empty."><CollectionView.ItemTemplate><DataTemplate><Frame Margin="0,5"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><VerticalStackLayout><Label Text="{Binding Title}" FontAttributes="Bold"/><Label Text="{Binding DeletedUtc, StringFormat='Deleted: {0:g}'}" Style="{StaticResource SubtitleLabel}"/></VerticalStackLayout><Button Grid.Column="1" Text="Restore" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RestoreCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}"/><Button Grid.Column="2" Text="Delete" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" BackgroundColor="{StaticResource Danger}"/></Grid></Frame></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
  </Grid>
</ContentPage>
