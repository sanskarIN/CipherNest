<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <x:Double x:Key="BodyFontSize">15</x:Double>
  <x:Double x:Key="CaptionFontSize">14</x:Double>
  <x:Double x:Key="TitleFontSize">30</x:Double>
  <x:Double x:Key="ControlFontSize">15</x:Double>

  <Style TargetType="ContentPage">
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
  </Style>
  <Style TargetType="Label">
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
  </Style>
  <Style x:Key="TitleLabel" TargetType="Label">
    <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}" />
    <Setter Property="FontAttributes" Value="Bold" />
  </Style>
  <Style x:Key="SubtitleLabel" TargetType="Label">
    <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
  </Style>
  <Style TargetType="Entry">
    <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style TargetType="Editor">
    <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
  </Style>
  <Style TargetType="Picker">
    <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
  </Style>
  <Style TargetType="SearchBar">
    <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
    <Setter Property="TextColor" Value="White" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="MinimumHeightRequest" Value="44" />
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
  </Style>
  <Style TargetType="Frame">
    <Setter Property="HasShadow" Value="False" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
    <Setter Property="BorderColor" Value="Transparent" />
  </Style>
</ResourceDictionary>
