<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:CipherNest.App.Views"
       x:Class="CipherNest.App.AppShell"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False">
  <ShellContent Route="startup" ContentTemplate="{DataTemplate views:StartupPage}" />
  <ShellContent Route="onboarding" ContentTemplate="{DataTemplate views:OnboardingPage}" />
  <ShellContent Route="unlock" ContentTemplate="{DataTemplate views:UnlockPage}" />
  <ShellContent Route="vault" ContentTemplate="{DataTemplate views:VaultPage}" />
  <ShellContent Route="generator" ContentTemplate="{DataTemplate views:GeneratorPage}" />
  <ShellContent Route="audit" ContentTemplate="{DataTemplate views:AuditPage}" />
  <ShellContent Route="trash" ContentTemplate="{DataTemplate views:TrashPage}" />
  <ShellContent Route="settings" ContentTemplate="{DataTemplate views:SettingsPage}" />
  <ShellContent Route="about" ContentTemplate="{DataTemplate views:AboutPage}" />
</Shell>
